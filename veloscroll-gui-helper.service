[Unit]
Description=VeloScroll GUI privileged helper (system D-Bus + polkit)
Documentation=https://github.com/LucasTippelt/VeloScroll-GUI
After=dbus.socket

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/veloscroll-gui/helper_service.py
BusName=org.veloscroll.gui
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
